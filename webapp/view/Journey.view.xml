<mvc:View
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    controllerName="ui5.agi_learning_hub.controller.Journey">
    <Page
        showHeader="false">
        <content>
            <VBox alignItems="Start" backgroundDesign="Solid" class="AgiHeaderSpace">
                <Title text="{title}" wrapping="true" class="AgiHeader2 sapUiSmallMarginTopBottom" />
                <Text text="{description}" class="sapUiSmallMarginTopBottom"></Text>
                <Button text="{i18n>continueJourney}" />
            </VBox>
            <VBox class="sapUiLargeMarginTop AgiCenterContainer">
                <HBox width="calc(100% - 20rem)" justifyContent="Center" class="AgiTimeLine">
                    <VBox
                        items="{path: 'course_ids',
				        factory: '.createCourseList'}"
                        width="100%">
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>