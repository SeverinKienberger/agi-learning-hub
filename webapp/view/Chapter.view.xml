<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    xmlns="sap.tnt"
    xmlns:core="sap.ui.core"
    controllerName="ui5.agi_learning_hub.controller.Chapter"
    height="100%">

    <ToolPage id="toolPage">
        <sideContent>
            <SideNavigation expanded="true" selectedKey="" itemSelect="onItemSelect">
                <item>
                    <NavigationList items="{units}">
                        <NavigationListItem items="{chapters}" key="{id}" text="{title}">
                            <NavigationListItem text="{title}" key="{id}" select=".onChapterPress" />
                        </NavigationListItem>
                    </NavigationList>
                </item>
            </SideNavigation>
        </sideContent>
        <mainContents>
            <m:Page id="chapterDetails" showHeader="false">
                <m:HBox class="sapUiSmallMargin" width="100%">
                    <m:VBox id="chapterContainer" />
                </m:HBox>
            </m:Page>
        </mainContents>
    </ToolPage>
</mvc:View>