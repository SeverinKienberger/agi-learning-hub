<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    controllerName="ui5.agi_learning_hub.controller.Chapter"
    height="100%">

    <tnt:ToolPage id="toolPage">
        <tnt:sideContent>
            <tnt:SideNavigation expanded="true" selectedKey="" itemSelect="onItemSelect">
                <tnt:item>
                    <tnt:NavigationList items="{units}">
                        <tnt:NavigationListItem items="{chapters}" key="{id}" text="{title}">
                            <tnt:NavigationListItem text="{title}" key="{id}"  select=".onChapterPress"/>
                        </tnt:NavigationListItem>
                    </tnt:NavigationList>
                </tnt:item>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <Page id="chapterDetails" showHeader="false">
                <core:HTML id="chapterHtml"/>
            </Page>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>