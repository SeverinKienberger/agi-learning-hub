<mvc:View
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:mvc="sap.ui.core.mvc"
	controllerName="ui5.agi_learning_hub.controller.App">
	<VBox>
		<f:ShellBar title="Learning Hub"
			homeIcon="images/AGILITA Logo-01.svg"
			showNavButton="true"
			navButtonPressed=".onNavBack">
			<f:profile>
				<Avatar initials="SK" />
			</f:profile>
		</f:ShellBar>
		<IconTabHeader
			id="iconTabHeader"
			backgroundDesign="Solid"
			mode="Inline"
			select="onTabSelect">
			<items>
				<IconTabFilter key="landing" id="landingTab" text="{i18n>landingPageTitle}" />
				<IconTabFilter key="myLearning" id="myLearningTab" text="{i18n>myLearningPageTitle}" />
				<IconTabFilter key="browse" id="browseTab" text="{i18n>browsePageTitle}">
					<items>
						<IconTabFilter key="browseCourses" text="{i18n>browseCoursesPageTitle}" />
						<IconTabFilter key="browseLearnings" text="{i18n>browseLearningsPageTitle}" />
					</items>
				</IconTabFilter>
				<IconTabFilter key="mySuccess" id="mySuccessTab" text="{i18n>mySuccessPageTitle}">
					<items>
						<IconTabFilter key="myBadges" text="{i18n>myBadgesPageTitle}" />
						<IconTabFilter key="myCertificates" text="{i18n>myCertificatesPageTitle}" />
					</items>
				</IconTabFilter>
			</items>
		</IconTabHeader>
		<Shell
			appWidthLimited="false">
			<App
				id="app" />
		</Shell>
	</VBox>
</mvc:View>