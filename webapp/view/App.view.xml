<mvc:View
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:mvc="sap.ui.core.mvc"
  	controllerName="ui5.agi_learning_hub.controller.App">
	<VBox>
		<f:ShellBar title="Learning Hub"
			homeIcon="images/AGILITA Logo-01.svg">
			<f:profile>
				<Avatar initials="SK"/>
			</f:profile>
		</f:ShellBar>
		<IconTabHeader
			id="iconTabHeader"
			selectedKey="invalidKey"
			backgroundDesign="Transparent"
			mode="Inline">
			<layoutData>
				<OverflowToolbarLayoutData priority="NeverOverflow" shrinkable="true" />
			</layoutData>
			<items>
				<IconTabFilter key="info" text="{i18n>landingPageTitle}"/>
				<IconTabFilter key="info" text="{i18n>myLearningPageTitle}"/>
				<IconTabFilter key="info" text="{i18n>browsePageTitle}">
					<items>
						<IconTabFilter text="{i18n>browseCoursesPageTitle}"/>
						<IconTabFilter text="{i18n>browseLearningsPageTitle}"/>
						<IconTabFilter text="{i18n>browseAllPageTitle}"/>
					</items>
				</IconTabFilter>
				<IconTabFilter key="info" text="{i18n>mySuccessPageTitle}">
					<items>
						<IconTabFilter text="{i18n>myBadgesPageTitle}"/>
						<IconTabFilter text="{i18n>myCertificatesPageTitle}"/>
					</items>
				</IconTabFilter>
			</items>
		</IconTabHeader>
	<Shell
	appWidthLimited="false">
		<App
		id="app"/>
	</Shell>
	</VBox>
</mvc:View>