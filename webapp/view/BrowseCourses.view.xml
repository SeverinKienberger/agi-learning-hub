<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:grid="sap.ui.layout.cssgrid"
    controllerName="ui5.agi_learning_hub.controller.BrowseCourses">

    <ScrollContainer height="100%" vertical="true" horizontal="false">
        <VBox alignItems="Center" backgroundDesign="Solid">
            <Title text="{i18n>coursePageTitle}" wrapping="true" class="AgiHeader1" />
        </VBox>
        <VBox alignItems="Stretch" class="AgiGridListContainer">
            <Toolbar design="Transparent" class="AgiFilterBar">
                <SearchField id="search" width="25%" search=".onFilterCourses"
                    class="AgiFilterElement" />
                <MultiComboBox
                    width="25%"
                    placeholder="Level"
                    class="AgiFilterElement"
                    selectionChange=".onFilterLevel"
                    items="{
                        path: '/master_data/levels'
                    }">
                    <core:Item key="{id}" text="{title}" />
                </MultiComboBox>
            </Toolbar>
            <f:GridList
                id="gridList"
                items="{/master_data/courses}"
                itemPress=".onCoursePress"
                class="AgiGridList">
                <f:customLayout>
                    <grid:GridBoxLayout boxMinWidth="15rem" />
                </f:customLayout>
                <f:GridListItem type="Active">
                    <VBox class="sapUiSmallMargin" justifyContent="SpaceBetween"
                        height="calc(100% - 30px)">
                        <layoutData>
                            <FlexItemData growFactor="7" shrinkFactor="0" />
                        </layoutData>
                        <Text text="{i18n>course}" />
                        <Title text="{title}" wrapping="true" />
                        <Text text="{description}" wrapping="true" />
                        <HBox justifyContent="SpaceBetween" width="100%" class="sapUiSmallMarginTop">
                            <Text text="{ path: 'level_id', formatter: '.LevelFormatter'}"
                                wrapping="true" />
                            <Text
                                text="{= ( ${total_duration_minutes} - ${total_duration_minutes} % 60 ) / 60
                                            + ' h ' +
                                        ( ${total_duration_minutes} % 60 ) + ' min' }"
                                wrapping="false" />
                        </HBox>
                    </VBox>
                </f:GridListItem>
            </f:GridList>
        </VBox>
    </ScrollContainer>
</mvc:View>