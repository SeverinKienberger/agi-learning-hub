<VBox
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:microchart="sap.suite.ui.microchart">
    <ScrollContainer
        id="quizScroll"
        vertical="true"
        width="100%"
        height="100%"
        focusable="true">
        <VBox
            alignItems="Center">
            <VBox width="100%" height="5rem" alignItems="Start" justifyContent="Center"
                backgroundDesign="Solid" class="sapUiMediumMarginBottom">
                <Title text="{title}" class="AgiHeader2 sapUiSmallMarginBegin" />
            </VBox>

            <VBox id="questionContainer" width="calc(100% - 21rem)" gap="1.5rem">
                <VBox
                    items="{
                path: 'questions',
                factory: '.createQuestion'
                }"
                    width="100%"
                    gap="2.5rem">
                </VBox>
            </VBox>
            <Button
                text="{i18n>evaluateAnswers}"
                press="._onEvaluateAnswers"
                class="sapUiMediumMarginTopBottom"
                visible="{= !${uiControl>/showFeedback} }" />
        </VBox>
        <VBox id="feedbackWrapper" visible="{uiControl>/showFeedback}"
            alignItems="Center" width="100%">
            <VBox width="calc(100% - 21rem)">
                <Panel class="sapMTile AgiNoMarginStartEnd sapUiSmallMarginTopBottom">
                    <HBox justifyContent="SpaceBetween" alignItems="End" width="100%">
                        <HBox justifyContent="Center">
                            <layout:HorizontalLayout class="sapUiSmallMarginEnd">
                                <microchart:RadialMicroChart
                                    size="L" percentage="{uiControl>/rating/percentage}"
                                    valueColor="{uiControl>/rating/result}" width="6rem"></microchart:RadialMicroChart>
                            </layout:HorizontalLayout>
                            <VBox>
                                <Title class="AgiHeader2"
                                    text="{= ${uiControl>/rating/result} === 'Good' ? ${i18n>feedbackGood} : ${i18n>feedbackBad} }"></Title>
                                <Text
                                    text="{uiControl>/rating/correctQuestions} von {uiControl>/rating/questionAmount} Fragen sind richtig beantwortet worden"></Text>
                            </VBox>
                        </HBox>
                        <Button
                            text="Test widerhohlen" press=".resetQuiz" />
                    </HBox>
                </Panel>
            </VBox>
        </VBox>
    </ScrollContainer>
</VBox>